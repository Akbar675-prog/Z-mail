# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API Key for reading inbound emails from Resend Receiving API
RESEND_API_KEY=

# RESEND_OTP_API_KEY: API Key for sending OTP verification emails
RESEND_OTP_API_KEY=

# OTP_SENDER_EMAIL: Sender address for OTP verification emails (e.g. no-reply@verification.visora.my.id)
OTP_SENDER_EMAIL="no-reply@verification.visora.my.id"

# RESEND_DOMAIN: Primary domain for Z-Mail mailboxes (e.g. visora.my.id)
RESEND_DOMAIN="visora.my.id"

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyz.supabase.co)
SUPABASE_URL=

# SUPABASE_KEY: Supabase Anon or Service Role Key
SUPABASE_KEY=
